# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/e-library

# JWT (consumed starting M4 - Login)
JWT_ACCESS_SECRET=jwt_access_secret
JWT_REFRESH_SECRET=jwt_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookie signing secret
COOKIE_SECRET=cookie_signing_secret

REDIS_URL="rediss://default:redis_password@redis_host:6379"

# Email (password reset, consumed starting M9). Optional in development —
# if left blank, reset links are logged to the console instead of emailed.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=E-Library <no-reply@e-library.local>

CLOUDINARY_CLOUD_NAME=cloudinary_cloud_name
CLOUDINARY_API_KEY=cloudinary_api_key
CLOUDINARY_API_SECRET=cloudinary_api_secret